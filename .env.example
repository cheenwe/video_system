# 基础平台 - 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# Docker 构建：APT_MIRROR=huawei；PIP_MIRROR=tsinghua（清华 PyPI，off 则用官方源）
# APT_MIRROR=huawei
# PIP_MIRROR=tsinghua

# 上传后自动转码 MOV/MKV 等为 MP4(H.264+AAC)；需安装 ffmpeg（Docker 镜像已包含）
# VIDEO_TRANSCODE_ENABLED=true
# 上传后生成 HLS 切片，弱网自适应播放（主档 + 480p + 360p，可选 240p）
# VIDEO_HLS_ENABLED=true
# 是否生成低清档位（关闭则只保留主档）
# VIDEO_HLS_ABR=true
# VIDEO_HLS_ABR_LADDER=true
# 高清档切片时长（秒）
# VIDEO_HLS_SEGMENT_SEC=6
# 弱网低档（480p/360p/240p）切片时长，更短可加快起播与切档
# VIDEO_HLS_LOW_SEGMENT_SEC=4
# 额外生成 240p 档位；磁盘与转码成本更高，仅极弱网场景建议开启
# VIDEO_HLS_240P=false
# 关键帧与切片时长对齐；主档源 GOP 过大时会改为对齐重编码（上传耗时增加）
# VIDEO_HLS_KEYFRAME_ALIGN=true
# 用 ffprobe 探测真实码率写入 master.m3u8（关闭则用预设估值）
# VIDEO_HLS_PROBE_BITRATE=true
# VIDEO_HLS_PROBE_SAMPLE_SEGMENTS=5
# .ts 切片缓存时长（秒）；切片内容寻址且 URL 带鉴权参数，可长缓存
# VIDEO_HLS_SEGMENT_CACHE_SEC=86400
# MP4 Range 回退的单次分块大小（KB）；弱网调小可降低单次等待
# VIDEO_STREAM_CHUNK_KB=256

# ---------- 对象存储 / CDN（P2，默认 local 不改行为） ----------
# 视频与 HLS 分片的下发后端：local（应用代理）| s3（OSS/COS/MinIO 等 S3 兼容）
# VIDEO_STORAGE_BACKEND=local
# CDN/自定义域名；配置后优先生成带该域名的签名 URL
# VIDEO_CDN_BASE_URL=
# 预签名 URL 时效（秒）；平台侧仍做鉴权，不会绕过权限
# VIDEO_SIGNED_URL_TTL_SEC=300
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=video-hls
# S3_PATH_STYLE=false
# HLS 生成后异步同步到对象存储（失败不影响本地播放）
# VIDEO_HLS_SYNC_STORAGE=true
# Service Worker 片段缓存（只缓存带鉴权参数的 HLS 媒体分片）
# VIDEO_SW_CACHE_ENABLED=true
# 播放质量（QoE）采集与上报
# VIDEO_QOE_ENABLED=true
# HLS 健康巡检：周期扫描缺切片的 ready 视频并自动补切片
# VIDEO_HLS_HOUSEKEEPING_ENABLED=true
# VIDEO_HLS_HOUSEKEEPING_INTERVAL_SEC=900
# VIDEO_HLS_HOUSEKEEPING_BATCH=3

# ---------- 服务 ----------
HOST=0.0.0.0
# HTTP 监听端口（本地开发与 Docker 宿主机/容器内均使用此项，默认 8808）
PORT=8808
# 生产 worker 数；>1 时备份邮件请改用 cron（见 docs/deploy.md）
WEB_CONCURRENCY=1
# 仅 DEBUG=true 时开启 /docs、/redoc、/openapi.json；生产请设为 false
DEBUG=true

# ---------- 数据库 ----------
# 本地 SQLite 示例
# DATABASE_URL=sqlite:///./data/lab_system.db
#
# MySQL 示例（本地直连）
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/lab_system?charset=utf8mb4
DATABASE_URL=sqlite:///./data/lab_system.db

# Docker Compose MySQL 参数（mysql / prod profile）
MYSQL_PUBLISH_PORT=3306
MYSQL_HOST=mysql
MYSQL_PORT=3306
WAIT_FOR_DB=true
DB_WAIT_TIMEOUT=90
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lab_system
MYSQL_USER=lab_user
MYSQL_PASSWORD=lab_pass

# ---------- Redis（Docker Compose 随 sqlite/mysql/prod 启动；本地非 Docker 可留空禁用）----------
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
REDIS_PUBLISH_PORT=6379
WAIT_FOR_REDIS=false
REDIS_WAIT_TIMEOUT=30

# ---------- 文件（须为本地目录；Docker 默认 /app/uploads 并挂载宿主机 ./uploads）----------
UPLOAD_ROOT=uploads
VIDEO_MAX_UPLOAD_MB=5120
VIDEO_CHUNK_SIZE_MB=5
# 是否允许游客播放公开视频（false 时所有播放均需登录）
VIDEO_ALLOW_ANONYMOUS_PLAY=true
VIDEO_COMMENT_GUEST_PREVIEW=2

# ---------- JWT ----------
SECRET_KEY=app-platform-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ---------- 默认管理员（仅首次无用户时创建） ----------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin2026

# ---------- CORS ----------
CORS_ORIGINS=*

# ---------- 登录安全 ----------
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=600

# ---------- 定时数据库备份 + SMTP 邮件 ----------
# 设为 true 时：单进程 uvicorn 下由应用内 APScheduler 每天定时执行；多 worker 建议用系统 cron 调用：
#   .venv/bin/python -m src.jobs.run_backup_email
# 备份附件格式为 ZIP（内含 MySQL .sql 或 SQLite .db）
BACKUP_EMAIL_ENABLED=false
BACKUP_HOUR=3
BACKUP_MINUTE=0
BACKUP_TIMEZONE=Asia/Shanghai
MYSQLDUMP_PATH=mysqldump
BACKUP_EMAIL_TO=
BACKUP_KEEP_LOCAL_COPY=false
BACKUP_LOCAL_DIR=uploads/db_backups
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
